<?xml version="1.0"?>
<assembly>
  <id>server-plugin-assembly</id>
  <includeBaseDirectory>false</includeBaseDirectory>
  <formats>
    <format>zip</format>
  </formats>
  <files>
    <file>
      <source>target/server/teamcity-plugin.xml</source>
      <outputDirectory>/</outputDirectory>
    </file>
  </files>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}/../server/kotlin-dsl</directory>
      <outputDirectory>/kotlin-dsl</outputDirectory>
    </fileSet>
  </fileSets>
  <moduleSets>
    <moduleSet>
      <useAllReactorProjects>true</useAllReactorProjects>
      <includes>
        <include>org.jetbrains.teamcity.builds:server</include>
      </includes>
      <binaries>
        <outputDirectory>server</outputDirectory>
        <unpack>false</unpack>
        <dependencySets>
          <dependencySet>
            <scope>runtime</scope>
            <includes>
              <include>*</include>
            </includes>
          </dependencySet>
        </dependencySets>
      </binaries>
    </moduleSet>
  </moduleSets>
</assembly>
