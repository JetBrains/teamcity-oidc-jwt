<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                            http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
       default-autowire="constructor">
    <!-- Settings store -->
    <bean class="org.jetbrains.teamcity.builds.oidc.signer.gcp.CloudKMSSettings" />

    <!-- Admin settings -->
    <bean class="org.jetbrains.teamcity.builds.oidc.signer.gcp.admin.CloudKMSConnectionChecker" />
    <bean class="org.jetbrains.teamcity.builds.oidc.signer.gcp.admin.CloudKMSAdminSettings" />

    <!-- Default client -->
    <bean class="org.jetbrains.teamcity.builds.oidc.signer.gcp.client.CloudKMSDefaultClient" />

    <!-- Signer -->
    <bean class="org.jetbrains.teamcity.builds.oidc.signer.gcp.CloudKMSSigner" />
</beans>
